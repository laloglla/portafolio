<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Eduardo Gallareta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&display=swap">
<style>
@font-face{font-family:"Open Sauce Sans";font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Open Sauce Sans";font-style:normal;font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Open Sauce Sans";font-style:normal;font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Open Sauce Sans";font-style:italic;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}

:root{
  /* palette: #FFFEF1 · #EDF4D8 · #D0F2A3 · #7DC74B · #242526 */
  --bg:#FFFEF1; --surface:#EDF4D8; --hl:#D0F2A3; --green:#7DC74B; --ink:#242526;
  --muted:#565B50; --line:#D6E1C0; --link:#3B7519;
  --accent:#3B7519; --accent-soft:#D0F2A3; --signal:#242526; --signal-soft:#EDF4D8;
  --channel:#D0F2A3; --particle:#7DC74B;
  --display:"Anton","Arial Narrow","Helvetica Neue Condensed",Impact,sans-serif;
  --sans:"Open Sauce Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --serif:var(--sans); --mono:var(--sans);
  --box-bg:var(--surface); --box-ink:var(--ink); --box-muted:var(--muted); --box-line:var(--line); --box-link:var(--link); --box-chip:var(--hl);
  --about-bg:var(--box-bg); --about-ink:var(--box-ink); --about-muted:var(--box-muted); --about-line:var(--box-line); --about-link:var(--box-link);
  --photo-bg:var(--hl); --photo-ink:var(--ink); --chip-ink:var(--ink); --nav-on-bg:var(--ink); --nav-on-fg:var(--bg);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#1C1D1E; --surface:#242526; --hl:#34452A; --green:#7DC74B; --ink:#FFFEF1;
    --muted:#B5BAAC; --line:#393C36; --link:#A6DE7C;
    --accent:#A6DE7C; --accent-soft:#34452A; --signal:#FFFEF1; --signal-soft:#2E3129;
    --channel:#34452A; --particle:#7DC74B;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#1C1D1E; --surface:#242526; --hl:#34452A; --green:#7DC74B; --ink:#FFFEF1;
  --muted:#B5BAAC; --line:#393C36; --link:#A6DE7C;
  --accent:#A6DE7C; --accent-soft:#34452A; --signal:#FFFEF1; --signal-soft:#2E3129;
  --channel:#34452A; --particle:#7DC74B;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16.5px;line-height:1.62;padding-inline:clamp(16px,2.6vw,48px);padding-block:0 40px}
.wrap{max-width:none;margin:0 auto}
a{color:var(--link)}
a:focus-visible,button:focus-visible{outline:2px solid var(--green);outline-offset:3px}
h1,h2,h3{text-wrap:balance;margin:0}
.label{font-size:12.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

/* nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line);margin-inline:calc(-1 * clamp(16px,2.6vw,48px));padding-inline:clamp(16px,2.6vw,48px)}
nav .wrap{display:flex;justify-content:space-between;align-items:center;gap:10px 24px;padding-block:14px;flex-wrap:wrap}
nav .mark{font-family:var(--display);font-size:22px;letter-spacing:.02em;text-transform:uppercase;color:var(--ink);text-decoration:none}
nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
nav ul a{font-size:15px;font-weight:500;color:var(--ink);text-decoration:none;padding:6px 14px;border-radius:999px}
nav ul a:hover{background:var(--surface)}
nav ul a[aria-current="page"]{background:var(--nav-on-bg);color:var(--nav-on-fg)}

.view{padding-block:28px 16px}
.box{border-radius:18px}
.box,.view-title,.lead-note,.sim-fig{background:var(--box-bg);--ink:var(--box-ink);--muted:var(--box-muted);--line:var(--box-line);--link:var(--box-link);--hl:var(--box-chip);color:var(--ink)}
.about{background:var(--about-bg);--ink:var(--about-ink);--muted:var(--about-muted);--line:var(--about-line);--link:var(--about-link)}

/* home: row 1 */
.row-top{display:grid;grid-template-columns:minmax(220px,28%) 1fr;gap:22px;align-items:stretch}
.photo{margin:0;min-height:320px;display:grid;place-items:center;overflow:hidden;background:var(--photo-bg);color:var(--photo-ink)}
.photo img{width:100%;height:100%;object-fit:cover;object-position:28% 35%;display:block}
.photo .ph span{font-size:12.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:currentColor;opacity:.7}
.about{padding:30px 34px}
.about h1{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(36px,5vw,60px);line-height:1;letter-spacing:.005em;margin-top:10px}
.about .lede{font-size:18px;font-weight:500;line-height:1.5;margin:16px 0 0;max-width:40em}
.about-text{margin-top:16px}
.about-text p{max-width:70ch;margin:0 0 12px}
.about .meta{display:flex;flex-wrap:wrap;gap:4px 22px;font-size:14.5px;color:var(--muted)}
.contact{margin-top:20px;padding-top:16px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 20px}
.email{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.email code{font-family:var(--sans);font-size:16.5px;font-weight:500;user-select:all;color:var(--ink)}
.email button{font:600 14px var(--sans);background:var(--ink);color:var(--about-bg);border:0;border-radius:999px;padding:8px 18px;cursor:pointer}
.email button:hover{background:var(--green);color:#242526}

/* home: row 2 cards */
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:22px}
.card{display:flex;flex-direction:column;gap:12px;padding:26px 26px 24px;color:var(--ink);text-decoration:none;border:2px solid transparent;transition:border-color .15s ease,transform .15s ease}
.card:hover{border-color:var(--green);transform:translateY(-2px)}
.card .top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.card h2{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(30px,3.2vw,40px);line-height:1}
.card .num{font-family:var(--display);font-size:24px;line-height:1;padding:6px 10px;border-radius:10px;background:var(--hl);color:var(--chip-ink);font-variant-numeric:tabular-nums}
.card p{margin:0;color:var(--muted)}
.card ul{margin:0;padding:12px 0 0;list-style:none;display:grid;gap:6px;font-size:15px;border-top:1px solid var(--line)}
.card ul li{display:flex;gap:10px}
.card ul li::before{content:"";flex:0 0 7px;height:7px;border-radius:50%;background:var(--green);margin-top:.6em}
.card .go{margin-top:auto;padding-top:8px;font-weight:600;color:var(--link)}

/* section views */
.back{display:inline-block;font-size:15px;font-weight:500;color:var(--muted);text-decoration:none;margin-bottom:12px}
.back:hover{color:var(--ink)}
.view-title{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;border-radius:18px;padding:26px 30px;margin-bottom:22px}
.view-title h2{font-family:var(--display);font-weight:400;text-transform:uppercase;font-size:clamp(38px,5.4vw,64px);line-height:1}
.view-title .label{background:var(--hl);color:var(--chip-ink);padding:6px 12px;border-radius:999px}

.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}
.filters button{font:500 14px var(--sans);color:var(--ink);background:transparent;border:1.5px solid var(--line);border-radius:999px;padding:6px 15px;cursor:pointer}
.filters button:hover{border-color:var(--green)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.projects{display:grid}
.proj{display:grid;grid-template-columns:170px 1fr;gap:28px;padding-block:26px;border-bottom:1px solid var(--line)}
.proj .when{font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums;line-height:1.6}
.proj .when .role{display:block;color:var(--ink);font-weight:600;font-size:15px;margin-top:2px}
.proj h3{font-size:21px;font-weight:600;line-height:1.3}
.proj .org{font-size:15px;color:var(--muted);margin-top:4px}
.proj p{margin:12px 0 0;max-width:68ch}
.proj ul{margin:10px 0 0;padding-left:20px;max-width:68ch}
.proj ul li{margin-bottom:6px}
.proj ul li::marker{color:var(--green)}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px}
.tags span{font-size:13px;font-weight:500;padding:3px 10px;border-radius:999px;background:var(--hl);color:var(--chip-ink)}

.pubs{list-style:none;margin:0;padding:0}
.pubs li{padding-block:22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 180px;gap:8px 28px}
.pubs .t{font-size:19px;line-height:1.38;font-weight:600}
.pubs .tr{font-size:15px;color:var(--muted);margin-top:6px}
.pubs .who{font-size:15px;color:var(--muted);margin-top:8px}
.pubs .venue{font-size:15px;margin-top:4px;font-style:italic}
.pubs .side{text-align:right}
.status{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:999px;background:var(--hl);color:var(--chip-ink)}
.pubs .side .role{display:block;font-size:14.5px;color:var(--muted);margin-top:6px}

.skills{display:grid;margin:0}
.skill{display:grid;grid-template-columns:220px 1fr;gap:24px;padding-block:16px;border-bottom:1px solid var(--line)}
.skill dt{font-weight:600}
.skill dd{margin:0}
.lead-note{margin-top:28px;border-radius:18px;padding:24px 28px}
.lead-note h3{font-size:20px;font-weight:600;margin-top:8px}
.lead-note p{margin:8px 0 0;max-width:65ch}

/* figures */
.sim-fig{margin:20px 0 4px;max-width:560px;border-radius:16px;padding:16px}
.sim-fig.sq{max-width:360px}
.sim{display:block;width:100%;height:auto;font-family:var(--sans)}
.sim-fig figcaption{font-size:13.5px;color:var(--muted);margin-top:10px;line-height:1.5;max-width:62ch}
.sim-fig .fig-n{font-weight:600;color:var(--ink);margin-right:4px}
.sim .frame{fill:none;stroke:var(--line)}
.sim .fibre{fill:var(--channel)}
.sim .tr{fill:var(--green)}
.sim .tr.hi{fill:var(--ink)}
.sim .ax{stroke:var(--muted);stroke-width:1}
.sim .tk{fill:var(--muted);font-size:10.5px}
.sim .lbl{fill:var(--ink);font-size:11.5px}
.sim .free{fill:none;stroke:var(--muted);stroke-width:1.8}
.sim .hind{fill:none;stroke:var(--green);stroke-width:2.6}
.sim .dash{opacity:.45;stroke-width:1.5}
.sim .free-t{fill:var(--muted)} .sim .hind-t{fill:var(--link)}
.sim .chan{fill:none;stroke:var(--channel);stroke-linecap:round}
.sim .cell{fill:var(--ink)} .sim .sm{fill:var(--green)}
.sim .bond{stroke:var(--muted);stroke-width:2;stroke-linecap:round}
.sim .bond.dbl{stroke-width:4}
.sim .at-c{fill:var(--ink)} .sim .at-o{fill:var(--green)}
.sim .cursor{stroke:var(--line);stroke-width:1}

footer{font-size:14px;color:var(--muted);margin-top:36px;padding-top:16px;border-top:1px solid var(--line);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}


/* ---------- full-screen 16:9 home (desktop) ---------- */
@media (min-width:1000px) and (min-height:560px){
  #view-home{height:calc(100dvh - var(--navh,64px));box-sizing:border-box;display:grid;grid-template-rows:minmax(0,1.65fr) minmax(0,1fr);gap:clamp(12px,2vh,24px);padding-block:clamp(12px,2.2vh,28px)}
  .row-top{min-height:0;grid-template-columns:minmax(0,26%) 1fr;gap:clamp(12px,1.4vw,26px)}
  .photo{min-height:0;height:100%}
  .about{min-height:0;overflow:auto;padding:clamp(14px,2.4vh,36px) clamp(20px,2.4vw,46px);display:flex;flex-direction:column}
  .about h1{font-size:clamp(30px,min(5vw,9vh),110px);margin-top:.4vh}
  .about .meta{margin-top:.6vh}
  .about .lede{font-size:clamp(13.5px,min(1.1vw,2vh),22px);line-height:1.42;margin-top:1.2vh;max-width:none}
  .about-text{margin-top:1.4vh;columns:2;column-gap:clamp(20px,2.4vw,48px)}
  .about-text p{font-size:clamp(12.5px,min(.92vw,1.7vh),17px);line-height:1.48;margin:0 0 .8vh;max-width:none;break-inside:avoid}
  .about .meta{font-size:clamp(12px,min(.9vw,1.6vh),16px)}
  .contact{margin-top:auto;padding-top:1.4vh}
  .email code{font-size:clamp(14px,min(1.05vw,1.9vh),19px)}
  .cards{min-height:0;margin-top:0;gap:clamp(12px,1.4vw,26px)}
  .card{min-height:0;overflow:hidden;gap:clamp(5px,1vh,12px);padding:clamp(12px,2.2vh,30px) clamp(18px,1.8vw,34px)}
  .card h2{font-size:clamp(24px,min(3vw,5.2vh),60px)}
  .card .num{font-size:clamp(18px,min(1.6vw,3vh),32px)}
  .card p{font-size:clamp(13px,min(1vw,1.8vh),18px);line-height:1.45}
  .card ul{font-size:clamp(12.5px,min(.95vw,1.7vh),17px);gap:.6vh;padding-top:1.2vh}
  .card .go{font-size:clamp(13px,min(1vw,1.8vh),18px);padding-top:0}
  footer{margin-top:0}
}
@media (min-width:1000px) and (min-height:560px) and (max-height:760px){
  .card ul{display:none}
  .about .meta{display:none}
}
@media (max-width:900px){
  .cards{grid-template-columns:1fr}
}
@media (max-width:760px){
  .row-top{grid-template-columns:1fr}
  .photo{min-height:0;aspect-ratio:4/5;max-width:260px;width:100%}
  .about{padding:22px 20px}
  .proj{grid-template-columns:1fr;gap:8px}
  .pubs li{grid-template-columns:1fr}
  .pubs .side{text-align:left}
  .skill{grid-template-columns:1fr;gap:4px}
  .view-title{padding:20px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}.card:hover{transform:none}}
</style>
</head>
