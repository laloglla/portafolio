<script>
// nav height -> --navh
(function(){const n=document.querySelector('nav');const set=()=>document.documentElement.style.setProperty('--navh',n.offsetHeight+'px');set();addEventListener('resize',set);})();
// Views: home + one view per card
(function(){
  const views={home:'view-home',research:'view-research',publications:'view-publications',skills:'view-skills'};
  const links=[...document.querySelectorAll('nav ul a')];
  function route(){
    const k=(location.hash||'#home').slice(1);
    const v=views[k]?k:'home';
    Object.entries(views).forEach(([n,id])=>{document.getElementById(id).hidden=(n!==v);});
    links.forEach(a=>{ if(a.dataset.v===v && a.getAttribute('href')==='#'+(k==='contact'?'contact':v)) a.setAttribute('aria-current','page'); else a.removeAttribute('aria-current'); });
    if(k==='contact'){document.getElementById('contact').scrollIntoView({block:'center'});}
    else window.scrollTo(0,0);
  }
  window.addEventListener('hashchange',route); route();
})();

// Project filters
(function(){
  const btns=[...document.querySelectorAll('.filters button')];
  const items=[...document.querySelectorAll('.proj')];
  btns.forEach(b=>b.addEventListener('click',()=>{
    const f=b.dataset.f;
    btns.forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false'));
    items.forEach(it=>{it.hidden = f!=='all' && !it.dataset.tags.split(' ').includes(f);});
  }));
})();

// Copy email
(function(){
  const btn=document.getElementById('copy'), mail=document.getElementById('mail');
  btn.addEventListener('click',()=>{
    const done=()=>{btn.textContent='Copied';setTimeout(()=>btn.textContent='Copy',1800);};
    const fallback=()=>{const r=document.createRange();r.selectNodeContents(mail);const s=getSelection();s.removeAllRanges();s.addRange(r);btn.textContent='Selected';setTimeout(()=>btn.textContent='Copy',1800);};
    try{navigator.clipboard.writeText(mail.textContent).then(done,fallback);}catch(e){fallback();}
  });
})();



if(matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('svg.sim').forEach(s=>{try{s.pauseAnimations();}catch(e){}});
</script>

